# =============================================================================
#  로컬 개발 환경 변수 예시
#
#  사용법:
#    1) 이 파일을 envs/.local.env 로 복사
#       cp envs/example.local.env envs/.local.env
#    2) 프로젝트 루트의 .env 심볼릭 링크가 envs/.local.env 를 가리키게 한다
#       ln -sf envs/.local.env .env
#    3) 아래 PLACEHOLDER 값들을 실제 값으로 교체
#
#  주의: 실제 .local.env / .prod.env 는 .gitignore 로 막혀 있어야 한다.
#        본 example 파일에는 절대 진짜 시크릿을 넣지 말 것.
# =============================================================================

# ─── Docker 이미지 ────────────────────────────────────────────────
DOCKER_USER=your-dockerhub-username
DOCKER_REPOSITORY=ai-health

# ─── FastAPI ───────────────────────────────────────────────────
APP_VERSION=v1.0.0
# JWT 서명용 비밀 키. 32자 이상 임의 문자열 사용 권장.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
COOKIE_DOMAIN=localhost

# ─── AI Worker ────────────────────────────────────────────────
AI_WORKER_VERSION=v1.0.0

# ─── Database (PostgreSQL + pgvector) ─────────────────────────
# 로컬에서 uvicorn 직접 실행 시 localhost.
# docker compose 안의 fastapi/ai-worker 컨테이너는 environment 로
# DB_HOST=postgres 를 자동 오버라이드한다.
DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ai_health

# ─── Redis ────────────────────────────────────────────────────
# docker compose 안에서는 redis 서비스명으로 해석.
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── (선택) HuggingFace ──────────────────────────────────────
# SigLIP2 등 비공개 모델 다운로드 시 토큰 설정. 공개 모델만 쓰면 비워둬도 OK.
# HF_TOKEN=hf_your_token_here

# ─── OpenAI (RAG / ChatRAGGraph) ─────────────────────────────
# 챗봇 RAG·임베딩 호출 키. 인덱싱 스크립트(scripts/rag/index_documents.py)와
# 향후 ChatRAGGraph 모두 본 값을 사용한다. 미설정 시 RAG 기능 비활성.
OPENAI_API_KEY=sk-replace-me
# 임베딩 모델 — vector(1536). 변경 시 rag_documents 컬럼 차원 재이전 필요.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 챗봇 LLM 모델.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# 호출당 타임아웃(초). LLM stall 시 FastAPI 워커 점유를 막기 위해 짧게 설정.
# OPENAI_REQUEST_TIMEOUT=20.0
# OPENAI_MAX_RETRIES=1

# ─── 검증 도구 (scripts/rag/chat_repl.py) — 선택 ────────────────────
# ChatRAGGraph REPL/단발 검증 시 사용할 테스트 사용자 UUID. 미설정 시 검증 도구만
# 사용 불가, 운영 코드에는 영향 없음. 실제 사용자 UUID 노출 방지를 위해 ENV 분리.
# CHAT_REPL_USER_WITH_DATA=
# CHAT_REPL_USER_PARTIAL=
# CHAT_REPL_USER_NO_DATA=

# ─── 이메일 발송 (SMTP) — 본인 인증 메일 ──────────────────────────
# SMTP_HOST/SMTP_USER 가 비어 있으면 실발송 대신 인증 링크를 콘솔(로그)에 출력한다.
# 실발송하려면 아래를 채운다. (Gmail: 2단계 인증 후 앱 비밀번호 16자리)
# 포트 465=implicit TLS(기본·권장), 587=STARTTLS — send_email 이 포트로 자동 분기.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=replace-me@example.com
# SMTP_PASSWORD=replace-me-app-password
# SMTP_FROM=replace-me@example.com
# 인증 링크에 사용할 프론트엔드 베이스 URL (실제 호스트로 교체)
FRONTEND_BASE_URL=http://your-frontend-host:3000

# ─── 카카오 소셜 로그인 (OAuth2) ──────────────────────────────────
# 카카오 개발자 콘솔(https://developers.kakao.com)에서 발급. 미설정이면 카카오 로그인 비활성.
# REST API 키 / Client Secret / Redirect URI(콘솔 등록값과 정확히 일치, 프론트 콜백 경로).
# KAKAO_REST_API_KEY=your_kakao_rest_api_key
# KAKAO_CLIENT_SECRET=your_kakao_client_secret
# KAKAO_REDIRECT_URI=http://localhost:3000/kakao/callback
