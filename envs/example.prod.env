# =============================================================================
#  프로덕션 환경 변수 예시 (EC2 배포용)
#
#  사용법:
#    1) 이 파일을 envs/.prod.env 로 복사 후 실제 값으로 교체
#    2) 배포 시 .env -> envs/.prod.env 심볼릭 링크
#    3) DB_PASSWORD / SECRET_KEY 는 반드시 강력한 임의값으로 변경
# =============================================================================

# ─── Docker 이미지 ────────────────────────────────────────────────
DOCKER_USER=your-dockerhub-username
DOCKER_REPOSITORY=ai-health

# ─── FastAPI ───────────────────────────────────────────────────
APP_VERSION=v1.0.0
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
COOKIE_DOMAIN=your-domain.com

# ─── AI Worker ────────────────────────────────────────────────
AI_WORKER_VERSION=v1.0.0

# ─── Database (PostgreSQL + pgvector) ─────────────────────────
# 컨테이너 네트워크에서는 postgres 서비스명으로 해석.
DB_HOST=postgres
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=ai_health

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── (선택) HuggingFace ──────────────────────────────────────
# HF_TOKEN=hf_your_token_here
